# Local configuration for the Aethera backend API.
# Copy this file to .env and fill in your own values. Never commit .env.

# Port the API listens on
PORT=8000

# MySQL connection
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=aethera_db

# Shared secret the Android client sends in the x-api-key header.
# Must match AETHERA_API_KEY in the client app.
AETHERA_API_KEY=your_api_key_here

# SMTP account used to send password reset codes
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email_here
EMAIL_PASS=your_email_password_here
